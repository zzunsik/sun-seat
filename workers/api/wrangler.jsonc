// sun-seat 앱 API 게이트웨이(#189). 배포·시크릿 입력 방법과 호출 제한 근거는 README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 운영 배포 주소는 https://api.<계정 workers.dev 하위 도메인>.workers.dev, 개발은 https://api-dev.<같은 하위 도메인>.workers.dev 가 된다.
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // 버전별 미리보기 주소는 쓰지 않는다(외부 API를 부를 수 있는 주소가 늘지 않게).
  "preview_urls": false,
  // 외부 API 키는 시크릿으로만 넣는다(wrangler secret put KAKAO_REST_API_KEY). 여기나 vars에 값을 적지 않는다.
  "secrets": { "required": ["KAKAO_REST_API_KEY"] },
  // 경로 묶음별 IP 호출 제한. 값의 근거는 README.md "호출 제한". 바꾸면 README와 테스트도 함께 고친다.
  // period는 10 또는 60(초)만 된다. 카운터는 Cloudflare 위치(데이터센터)마다 따로이고 근사값이다.
  "ratelimits": [
    {
      "name": "KAKAO_RATE_LIMITER",
      // 계정 안에서 고유한 양의 정수(문자열). 다른 Worker·묶음과 겹치면 카운터를 같이 쓴다.
      "namespace_id": "18901",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // 위의 최상위 설정이 운영 Worker `api`다(릴리스 빌드가 부른다. main에서 배포, #191).
  // 개발 Worker `api-dev`는 `wrangler deploy --env development`로 배포한다(develop에서 배포, 디버그 빌드가 부른다).
  // ratelimits·secrets는 환경으로 이어지지 않아 여기에 다시 적는다. 바인딩·상한·기간·필수 시크릿은 운영과 같게 두고
  // namespace_id만 다르게 둔다(카운터를 운영과 나누지 않게). 어긋나면 테스트가 실패한다.
  "env": {
    "development": {
      "name": "api-dev",
      "secrets": { "required": ["KAKAO_REST_API_KEY"] },
      "ratelimits": [
        {
          "name": "KAKAO_RATE_LIMITER",
          "namespace_id": "18902",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  }
}
